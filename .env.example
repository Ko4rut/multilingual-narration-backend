POSTGRES_DB=narration_db
POSTGRES_USER=narration_app
POSTGRES_PASSWORD=narration_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
API_PORT=8000
DATABASE_URL=postgresql+psycopg://narration_app:narration_dev_password@localhost:5433/narration_db

# JWT_PRIVATE_KEY và JWT_PUBLIC_KEYS phải được cấp qua secret manager hoặc môi
# trường triển khai. JWT_PUBLIC_KEYS là một JSON object ánh xạ kid -> public key.
JWT_ACTIVE_KEY_ID=auth-key-1
JWT_ISSUER=mnr-backend
JWT_AUDIENCE=mnr-admin-web
JWT_LEEWAY_SECONDS=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/identity
# AUTH_COOKIE_DOMAIN=admin.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
