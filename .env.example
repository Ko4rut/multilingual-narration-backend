# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=narration_db
POSTGRES_USER=narration_app
POSTGRES_PASSWORD=narration_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://narration_app:narration_dev_password@localhost:5433/narration_db

# =============================================================================
# Ứng dụng / máy chủ API
# =============================================================================
API_PORT=8000

# =============================================================================
# JWT access token
# =============================================================================
# Không có khóa mặc định: endpoint đăng nhập trả HTTP 503 nếu thiếu cấu hình khóa.
# JWT_PRIVATE_KEY là PEM private key; JWT_PUBLIC_KEYS là JSON ánh xạ kid -> PEM
# public key. Có thể biểu diễn xuống dòng PEM bằng ký tự \n trong biến môi trường.
# Cấp khóa thật qua secret manager hoặc environment của nền tảng triển khai.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEYS={"auth-key-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
# ID khóa đang ký token; giá trị này phải tồn tại trong JWT_PUBLIC_KEYS.
JWT_ACTIVE_KEY_ID=auth-key-1
# Đơn vị phát hành token và ứng dụng được phép nhận token.
JWT_ISSUER=mnr-backend
JWT_AUDIENCE=mnr-admin-web
# Dung sai lệch đồng hồ giữa các máy chủ, tính bằng giây.
JWT_LEEWAY_SECONDS=30
# Access token sống 15 phút; refresh token sống 30 ngày.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# =============================================================================
# Refresh token cookie
# =============================================================================
AUTH_REFRESH_COOKIE_NAME=refresh_token
# Giới hạn cookie chỉ được gửi đến các endpoint Identity.
AUTH_COOKIE_PATH=/api/v1/identity
# Để trống/không khai báo ở local. Production có thể đặt admin.example.com.
# AUTH_COOKIE_DOMAIN=admin.example.com
# Local HTTP có thể đặt false; production HTTPS bắt buộc đặt true.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict # Giá trị hợp lệ: lax, strict hoặc none. Nếu dùng none thì Secure phải là true.
